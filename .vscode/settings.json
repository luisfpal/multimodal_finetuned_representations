{
    "python.envFile": "${workspaceFolder}/.env",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.analysis.autoImportCompletions": true,
    "terminal.integrated.env.linux": {
        "PYTHONPATH": "${workspaceFolder}",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv"
    },
    "editor.formatOnSave": true,
    "jupyter": {
        "kernel_selections": {
            "python": "menv"
        }
    },
    "chat.tools.terminal.autoApprove": {
        "/^python3 /u/dssc/lpalaciosflores/multimodal_finetuned_representations/scripts/basic_benchmarking/create_vqav2_coco_icq\\.py$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^/u/dssc/lpalaciosflores/multimodal_finetuned_representations/\\.venv/bin/python /u/dssc/lpalaciosflores/multimodal_finetuned_representations/scripts/basic_benchmarking/create_vqav2_coco_icq\\.py$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^git add \\.$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}