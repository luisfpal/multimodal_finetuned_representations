{
    // ========================================
    // Python Environment
    // ========================================
    "python.envFile": "${workspaceFolder}/.env",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.analysis.typeCheckingMode": "off",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/utils"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests"
    ],
    "terminal.integrated.env.linux": {
        "PYTHONPATH": "/u/dssc/lpalaciosflores/multimodal_finetuned_representations",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv"
    },
    // ========================================
    // Editor Productivity
    // ========================================
    "editor.formatOnSave": false,
    "editor.rulers": [
        88
    ],
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.inlineSuggest.enabled": true,
    "editor.suggestSelection": "first",
    "editor.wordWrap": "off",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    // ========================================
    // File Explorer Declutter
    // ========================================
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.mypy_cache": true,
        "**/*.pyc": true,
        "**/.DS_Store": true,
        "**/.git": false
    },
    // ========================================
    // Search Performance (exclude large dirs)
    // ========================================
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/.venv": true,
        "**/venvs": true,
        "**/results": true,
        "**/evals": true,
        "**/logs": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/*.safetensors": true,
        "**/*.pt": true,
        "**/*.pth": true
    },
    // ========================================
    // Jupyter Notebooks
    // ========================================
    "jupyter": {
        "kernel_selections": {
            "python": "menv"
        }
    },
    "notebook.output.textLineLimit": 50,
    "notebook.cellToolbarLocation": {
        "default": "right"
    },
    // ========================================
    // Terminal Integration
    // ========================================
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.persistentSessionReviveProcess": "onExit",
    "terminal.integrated.shellIntegration.enabled": true,
    // ========================================
    // GitHub Copilot Auto-Approve (Safe Operations)
    // ========================================
    "chat.tools.terminal.autoApprove": {
        // === Python Testing ===
        "/^pytest$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^pytest .*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^python -m pytest$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^python -m pytest .*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        // === Git Read-Only Operations ===
        "/^git status$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^git diff$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^git diff .*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^git log$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^git log .*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^git show$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^git show .*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^git branch$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^git branch -[av].*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^git add \\.$/": {
            "approve": true,
            "matchCommandLine": true
        },
        // === File Operations (Safe) ===
        "/^ls$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^ls .*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^cat .*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^head .*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^tail .*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^wc .*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^find .*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^grep .*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        // === Package Management (Read-Only) ===
        "/^uv pip list$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^uv tree$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^uv pip show .*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        // === Python Introspection (Safe) ===
        "/^python -c \"import .*\"$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^python --version$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^which python$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}
