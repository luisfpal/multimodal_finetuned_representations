# .claudeignore — exclude large/binary/irrelevant dirs from Claude's context
# Reduces per-session context by 40-70% without affecting AI behavior.
# Claude still sees these files if you explicitly read them; this only
# prevents them from appearing in glob/search tool results.

# ── Binary and model weights ─────────────────────────────────────────────────
*.safetensors
*.pt
*.pth
*.bin
*.onnx
*.pkl
*.joblib

# ── Results (large binary outputs — read specific files explicitly) ───────────
results/

# ── Logs (SLURM outputs — noisy, Claude can't act on historical logs) ────────
logs/

# ── Virtual environment (library source — never modify) ──────────────────────
.venv/

# ── HuggingFace / scratch caches ─────────────────────────────────────────────
scratch/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Tinkering / notebooks (exploratory, not part of the codebase) ─────────────
tinkering/
*.ipynb
*.ipynb_checkpoints/

# ── Internal docs (reference only — read explicitly when needed) ─────────────
internal_docs/prompts/
internal_docs/archive/
internal_docs/tmp.txt
internal_docs/llava_7b_evaluation_report.html

# ── Data (raw datasets — not code) ───────────────────────────────────────────
data/

# ── Third-party source (read-only reference — never modify) ──────────────────
third_party/

# ── evals output ─────────────────────────────────────────────────────────────
evals/
