# THIRD-PARTY: keep only runtime-essential Cambrian source
# ============================================================================
third_party/cambrian/eval/
third_party/cambrian/scripts/
third_party/cambrian/dataengine/
third_party/cambrian/docs/
third_party/cambrian/images/
